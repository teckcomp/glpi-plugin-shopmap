{# ShopMap — canvas da planta (Bloco 2a). Autocontido; toda variável vem
   na associativa `sm` (front/plan.php). O JS expõe mount() com estado
   isolado (padrão do ambiente para conteúdo carregado via AJAX). #}
<link rel="stylesheet" href="{{ sm.leaflet_css }}">

<div class="container-fluid shopmap-plan">
    <div class="d-flex align-items-center justify-content-between mb-2">
        <h3 class="mb-0">
            <a href="{{ sm.back_url }}" class="me-2" title="Voltar ao ShopMap">
                <i class="ti ti-arrow-left"></i>
            </a>
            <i class="ti ti-map-2 me-1"></i>{{ sm.plan_name }}
        </h3>
        <div class="text-muted small">
            Zoom: roda do mouse / pinça &middot; Tela cheia: botão no mapa
        </div>
    </div>

    {# Toolbar de shapes: o JS remove o d-none quando o usuário pode editar #}
    <div id="shopmap-toolbar" class="d-none mb-2">
        <span class="text-muted me-2 small">Adicionar (clique no botão e depois na planta):</span>
        <button type="button" class="btn btn-outline-primary btn-sm" data-shapetype="equipment">
            <i class="ti ti-cpu me-1"></i>Equipamento
        </button>
        <button type="button" class="btn btn-outline-primary btn-sm" data-shapetype="rack">
            <i class="ti ti-server-2 me-1"></i>Rack
        </button>
        <button type="button" class="btn btn-outline-primary btn-sm" data-shapetype="passbox">
            <i class="ti ti-square-rounded me-1"></i>Caixa de passagem
        </button>
        <span class="mx-2 text-muted">|</span>
        <button type="button" class="btn btn-outline-warning btn-sm" id="shopmap-draw-cable">
            <i class="ti ti-route me-1"></i>Desenhar cabo
        </button>
        <button type="button" class="btn btn-outline-warning btn-sm" id="shopmap-quick-connect">
            <i class="ti ti-plug-connected me-1"></i>Conectar (2 cliques)
        </button>
        <span class="text-muted ms-2 small" id="shopmap-hint">Arraste um shape para reposicionar · clique nele para editar</span>
    </div>

    <div id="shopmap-canvas" class="shopmap-canvas card"></div>
</div>

<script type="application/json" id="shopmap-plan-data">{{ sm.plan_json|raw }}</script>
<script src="{{ sm.leaflet_js }}"></script>
<script src="{{ sm.plan_js }}"></script>
<script>
    window.ShopMapPlan && window.ShopMapPlan.mount('shopmap-canvas', 'shopmap-plan-data');
</script>
